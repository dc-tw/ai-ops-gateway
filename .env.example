APP_ENV=development
API_KEY=
# JSON map: {"secret":{"subject":"alice","tenant_id":"acme","role":"admin"}}
API_KEYS_JSON=
# Opt-in owner/share ACL. Rehearse legacy adoption in isolation before production rollout.
RESOURCE_ACL_ENABLED=false
# Opt-in v2 authoring and planning bindings; existing v1 hashes remain unchanged.
SKILL_V2_ENABLED=false
SKILL_AUTO_SELECTION_ENABLED=false
SKILL_PACKAGE_IMPORT_ENABLED=false
OIDC_JWKS_URL=
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_TENANT_CLAIM=tenant_id
OIDC_ROLE_CLAIM=role
# Browser console uses authorization-code + PKCE and a Redis-backed session.
OIDC_AUTHORIZATION_URL=
OIDC_TOKEN_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid profile
UI_SESSION_TTL_SECONDS=28800
UI_LOGIN_STATE_TTL_SECONDS=300
# Explicitly opt-in for local development only; Settings rejects this in production.
BROWSER_DEV_LOGIN_ENABLED=false
COLLABORATION_REFRESH_SECONDS=20
HUMAN_PRESENCE_TTL_SECONDS=60
AGENT_HEARTBEAT_TTL_SECONDS=60
LOG_LEVEL=INFO
OTEL_SERVICE_NAME=ai-ops-gateway
OTEL_EXPORTER_OTLP_ENDPOINT=

# Both Ollama and vLLM expose an OpenAI-compatible /v1 API.
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=local-only
LLM_MODEL=qwen2.5:7b-instruct
# Optional server-controlled aliases for per-turn Ollama/vLLM routing.
# LLM_ROUTES_JSON={"ollama-qwen":{"base_url":"http://ollama:11434/v1","model":"qwen2.5:7b-instruct","api_key":"local-only"},"vllm-qwen":{"base_url":"http://vllm:8000/v1","model":"Qwen/Qwen2.5-7B-Instruct","api_key":"local-only"}}
LLM_ROUTES_JSON=
LLM_ALLOW_ARBITRARY_MODELS=false
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=2048
# USD per one million provider-reported tokens; aliases may override these in LLM_ROUTES_JSON.
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0

REDIS_URL=redis://redis:6379/0
REDIS_STREAM_MAXLEN=10000
# Optional PostgreSQL history archive. Empty DSN leaves existing Redis behavior unchanged.
# Never commit a real DSN. For production use TLS and a managed database/secret manager.
POSTGRES_DSN=
# Stable identity for one Redis data source; never share it across unrelated Redis stores.
POSTGRES_SOURCE_ID=gateway
# shadow first; backfill and reconcile successfully before selecting postgres reads.
POSTGRES_HISTORY_MODE=shadow
POSTGRES_PROJECTOR_POLL_SECONDS=1
POSTGRES_OUTBOX_LEASE_MS=5000
# Local opt-in Compose service only. If changed, supply a matching POSTGRES_DSN.
POSTGRES_PASSWORD=local-postgres-only
LANGGRAPH_CHECKPOINTING=true
CHECKPOINT_TTL_MINUTES=10080
CONVERSATION_MAX_TURNS=40
CONVERSATION_TTL_SECONDS=604800
CONVERSATION_CONTEXT_MAX_TOKENS=6000

PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000
PLAYWRIGHT_MAX_CONTENT_CHARS=50000
# Strongly recommended in production. Example: docs.example.com,status.example.com
PLAYWRIGHT_ALLOWED_DOMAINS=
BROWSER_SESSION_TTL_SECONDS=1800
BROWSER_MAX_SESSIONS=20
BROWSER_WORKER_URL=
BROWSER_WORKER_TOKEN=change-me-internal
AGENT_TOOL_TRANSPORT=local
AUTONOMOUS_TOOL_PLANNING=true
AGENT_MAX_TOOL_ROUNDS=8
AGENT_DEFAULT_DEADLINE_SECONDS=300

AGENT_MAX_RETRIES=2
SSE_HEARTBEAT_SECONDS=15
GOAL_WORKER_POLL_SECONDS=2
GOAL_CONSUMER_GROUP=goal-workers
GOAL_LEASE_MS=60000
AUTOMATION_POLL_SECONDS=2
AUTOMATION_DEFAULT_MAX_RUNS_PER_DAY=24
AUTOMATION_DEFAULT_TOKEN_BUDGET=20000
AUTOMATION_DEFAULT_APPROVAL_TIMEOUT_SECONDS=86400
# Server-managed map {"automation UUID":"random HMAC secret, at least 32 characters"}.
# Keep secrets out of requests, committed files, SSE and audit payloads.
AUTOMATION_WEBHOOK_SECRETS_JSON=
# Tenant -> HTTPS destinations. Secrets stay in server configuration only.
# {"acme":[{"id":"ops","url":"https://hooks.example/gateway","secret":"at-least-32-characters","events":["goal.failed"]}]}
NOTIFICATION_WEBHOOKS_JSON=
NOTIFICATION_ALLOWED_HOSTS=
NOTIFICATION_RETRY_SECONDS=5
NOTIFICATION_MAX_ATTEMPTS=5
GATEWAY_PUBLIC_URL=
# ACP stdio adapter launch environment (normally set by the ACP client, not the server).
GATEWAY_BASE_URL=
GATEWAY_API_KEY=
GATEWAY_MODEL=
GATEWAY_ACP_ALLOW_INSECURE_LOCALHOST=false
TENANT_REQUESTS_PER_MINUTE=60
TENANT_MAX_CONCURRENT_RUNS=4
# Opt-in Plan v2 authoring/compilation only; saving or accepting never dispatches.
WORKFLOW_ENABLED=false
# Separate explicit admission gate. Mode changes alone still never enqueue.
# Disabling this gate stops new admissions, not already-admitted work.
WORKFLOW_EXECUTION_ENABLED=false
WORKFLOW_MAX_NODES=32
WORKFLOW_MAX_EDGES=64
WORKFLOW_MAX_PARALLELISM=4
REQUEST_TOKEN_BUDGET=16000
TENANT_DAILY_TOKEN_BUDGET=1000000
PII_REDACTION=true
# Comma-separated server-side regex patterns. Keep empty to disable.
CONTENT_BLOCKED_PATTERNS=

# Agent Threat Rules (pyatr). Detection is on; enforcement is opt-in.
ATR_ENABLED=true
ATR_BLOCKING=false
ATR_MIN_SEVERITY=medium
ATR_BLOCK_SEVERITY=high
ATR_MAX_CONTENT_CHARS=100000
# Full scans only: oversize, timeout or engine failure denies release even in detect-only mode.
ATR_SCAN_TIMEOUT_SECONDS=5
ATR_SCAN_MAX_WORKERS=4
# Per scan process address-space limit on Linux; CPU/wall limits also apply on macOS.
ATR_SCAN_MEMORY_MB=512
# Optional path to private/custom ATR YAML rules. Empty uses bundled rules.
ATR_RULES_DIR=
# Empty means all rules at/above ATR_BLOCK_SEVERITY are eligible for enforcement.
ATR_BLOCKING_RULE_IDS=
# Emergency false-positive override; findings are still recorded but never blocked.
ATR_BLOCKING_EXCLUDED_RULE_IDS=
ATR_FINDINGS_TTL_SECONDS=2592000
ATR_FINDINGS_MAX_RECORDS=10000
ATR_CALIBRATION_MIN_REVIEWS=20
ATR_CALIBRATION_MAX_FALSE_POSITIVE_RATE=0.05
